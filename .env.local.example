NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SQLite data directory — MUST be an ABSOLUTE path in production (the exact
# path on the production host/Bertha is a deploy-time decision). Relative
# values resolve against each process's cwd; the Next app and the media
# server run from different directories, so a relative value makes one of
# them silently create a second empty database. Leave empty for local dev
# (defaults to <repo>/server/data in both processes).
SLICER_DATA_DIR=

# AssemblyAI — transcription (required)
ASSEMBLYAI_API_KEY=

# Groq — default LLM scoring (optional, falls back to AssemblyAI highlights)
GROQ_API_KEY=

# OpenRouter — long-context A/B clip scoring via Nemotron 3 Super
# CLIP_SCORER: "groq" (default), "openrouter", or "ab"
OPENROUTER_API_KEY=
OPENROUTER_CLIP_MODEL=nvidia/nemotron-3-super-120b-a12b:free
CLIP_SCORER=groq

# Clip mode: "instant" (free, no render) or "shotstack" (real renders)
CLIP_MODE=instant

# Shotstack — video rendering (only needed for CLIP_MODE=shotstack)
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Backend protection (see SLICER_BACKEND_PROTECTION.md)
# Shared secret between the Next app and server/youtube-api.js. REQUIRED in any
# deployment where the backend is reachable through a tunnel/public hostname —
# without it, server-called endpoints (/job-start, /download*, /transcribe*,
# /score-clips, /still) accept unauthenticated requests. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLICER_INTERNAL_TOKEN=
# Cloudflare Access service token (optional — set when the backend tunnel
# hostname is behind Cloudflare Access; Next attaches these on backend calls)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Auth
# Set SKIP_AUTH=false to require login. Google/Discord OAuth require matching callback URLs:
# https://your-domain.com/api/auth/callback/google
# https://your-domain.com/api/auth/callback/discord
SKIP_AUTH=true
NEXT_PUBLIC_SKIP_AUTH=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DEV_USER_ID=dev-user-123

# Email login code delivery
# Recommended production setup: Resend + verified MCV-owned sender/domain.
# If these are NOT set, email login is unavailable (request endpoint returns 503,
# no code is minted). For local preview only, AUTH_EMAIL_DEBUG=true in a
# non-production build returns devCode; the flag is ignored in production.
AUTH_EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_DEBUG=
AUTH_EMAIL_FROM="Slicer <login@marscatsvoyage.com>"
NEXT_PUBLIC_APP_URL=https://slicer.marscatsvoyage.com
