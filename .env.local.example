NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AssemblyAI — transcription (required)
ASSEMBLYAI_API_KEY=

# Groq — LLM scoring (optional, falls back to AssemblyAI highlights)
GROQ_API_KEY=

# Clip mode: "instant" (free, no render) or "shotstack" (real renders)
CLIP_MODE=instant

# Shotstack — video rendering (only needed for CLIP_MODE=shotstack)
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Auth
# Set SKIP_AUTH=false to require login. Google/Discord OAuth require matching callback URLs:
# https://your-domain.com/api/auth/callback/google
# https://your-domain.com/api/auth/callback/discord
SKIP_AUTH=true
NEXT_PUBLIC_SKIP_AUTH=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DEV_USER_ID=dev-user-123
